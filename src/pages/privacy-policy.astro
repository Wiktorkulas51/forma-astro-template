---
import Layout from '@layouts/Layout.astro';
import '@styles/global.css';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import SectionHeader from '@components/ui/molecules/SectionHeader.astro';
import Button from '@components/ui/atoms/Button.astro';
---

<Layout locale="en" title="FORMA | Demo privacy information" description="Information about the demonstration form and sample content on the FORMA template." renderNavbar={false} renderMobileDrawer={false} renderFooter={false}>
  <Section>
    <Container>
      <SectionHeader
        title="Privacy in the demo version."
        description="This is a demonstration website template, not a real construction company website. Before using the template for a business, prepare a privacy policy that reflects how the website actually works."
      />
      <div class="grid max-w-3xl gap-10">
        <section><h2 class="text-2xl font-semibold">Demonstration form</h2><p>The form validates fields in your browser. It does not send messages or entered details to the template author or any other company. The confirmation shown after submission is only a demonstration. Do not enter confidential information.</p></section>
        <section><h2 class="text-2xl font-semibold">Hosting and map</h2><p>Hosting and infrastructure providers may process standard technical connection data. The map is provided by OpenStreetMap, and your browser connects to that provider when it loads. Google Analytics and Clarity IDs are not configured in this template.</p></section>
        <section><h2 class="text-2xl font-semibold">Sample content</h2><p>Names, project descriptions and reviews illustrate the template layout. They do not describe services provided by a real company.</p></section>
      </div>
      <Button href="/" class="mt-10">Back to the FORMA demo</Button>
      <a class="language-switch mt-10" href="/pl/privacy-policy/" lang="pl" aria-label="Switch language to Polish">PL</a>
    </Container>
  </Section>
</Layout>
