---
import Layout from '@layouts/Layout.astro';
import '@styles/global.css';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import SectionHeader from '@components/ui/molecules/SectionHeader.astro';
import ContentSections from '@components/ui/molecules/ContentSections.astro';
import { privacyPage } from '@data';
import Button from '@components/ui/atoms/Button.astro';
---

<Layout locale="pl" title={privacyPage.seo.title} description={privacyPage.seo.description} renderNavbar={false} renderMobileDrawer={false} renderFooter={false}>
  <Section>
    <Container>
      <SectionHeader title={privacyPage.title} description={privacyPage.lead} />
      <ContentSections sections={privacyPage.sections} class="grid gap-10 max-w-3xl" />
      <Button href="/pl/" class="mt-10">Wróć do demo Formy</Button>
      <a class="language-switch mt-10" href="/privacy-policy/" lang="en" aria-label="Switch language to English">EN</a>
    </Container>
  </Section>
</Layout>
