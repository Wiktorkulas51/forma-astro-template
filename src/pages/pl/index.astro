---
import Layout from '@layouts/Layout.astro';
import '@styles/global.css';
import '@styles/home.css';
import '@styles/services.css';
import SiteNavbar from '@components/ui/molecules/SiteNavbar.astro';
import HeroSection from '@components/ui/organisms/HeroSection.astro';
import ServicesSection from '@components/ui/organisms/ServicesSection.astro';
import ProjectsSection from '@components/ui/organisms/ProjectsSection.astro';
import WhySection from '@components/ui/organisms/WhySection.astro';
import ProcessSection from '@components/ui/organisms/ProcessSection.astro';
import TestimonialsSection from '@components/ui/organisms/TestimonialsSection.astro';
import AreaSection from '@components/ui/organisms/AreaSection.astro';
import FaqSection from '@components/ui/organisms/FaqSection.astro';
import FooterSection from '@components/ui/organisms/FooterSection.astro';
import ContactSection from '@components/ui/organisms/ContactSection.astro';
import '@styles/projects.css';
import '@styles/why.css';
import '@styles/process.css';
import '@styles/testimonials.css';
import '@styles/area.css';
import '@styles/faq.css';
import '@styles/contact.css';
import '@styles/interactions.css';
---

<Layout locale="pl" renderNavbar={false} renderMobileDrawer={false} renderFooter={false}>
  <div class="home relative isolate pt-5 font-sans" id="top">
    <SiteNavbar locale="pl" />
    <HeroSection locale="pl" />
    <ServicesSection locale="pl" />
    <div id="realizacje">
      <ProjectsSection variant="morph-refined" locale="pl" />
    </div>
    <div id="dlaczego-my">
      <WhySection variant="collage" locale="pl" />
    </div>
    <ProcessSection locale="pl" />
    <div id="opinie">
      <TestimonialsSection variant="spread" refinement="warm" locale="pl" />
    </div>
    <div id="obszar">
      <AreaSection variant="ink" copyVariant="editorial" locale="pl" />
    </div>
    <div id="faq">
      <FaqSection locale="pl" />
    </div>
    <div id="kontakt">
      <ContactSection variant="compact-air" showFooter={false} locale="pl" />
    </div>
    <div id="stopka">
      <FooterSection variant="graphite-quiet" locale="pl" />
    </div>
  </div>
</Layout>
