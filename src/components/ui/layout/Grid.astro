---
import type { HTMLAttributes } from 'astro/types';
import { toGridClasses, type GridColumns } from '@utils/grid-classes';

interface Props {
  /** Liczba kolumn od 1 do 12 albo ich wartości dla standardowych breakpointów. */
  cols?: GridColumns;
  /** Gap: "sm" | "md" | "lg" | "xl" lub dowolny string */
  gap?: string;
  class?: string;
  role?: HTMLAttributes<'div'>['role'];
}

const { cols = { default: 1, md: 3 }, gap = "md", class: className, role } = Astro.props;

const gapMap: Record<string, string> = {
  sm: "gap-3",
  md: "gap-6",
  lg: "gap-8",
  xl: "gap-12",
};
const gapClass = gapMap[gap] || gap;
---

<div class:list={["grid", toGridClasses(cols), gapClass, className]} {...(role ? { role } : {})}>
  <slot />
</div>
