---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';

interface SectionContent {
  heading: string;
  body: string;
}

interface Props {
  sections: SectionContent[];
  class?: string;
}

const { sections, class: className = 'grid gap-10 md:grid-cols-2' } = Astro.props as Props;
---

<div class={className}>
  {sections.map((section) => (
    <div>
      <Heading level={2} variant="feature-title">{section.heading}</Heading>
      <Text variant="body" class="mt-4 ui-text-on-light-subtle">{section.body}</Text>
    </div>
  ))}
</div>
