---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import LocationMap from '@components/ui/molecules/LocationMap.astro';
import area from '../../../data/sections/area-section.json';
import {
  getMapTitle,
  getOpenStreetMapEmbedUrl,
  getOpenStreetMapUrl,
} from '@utils/location-map';
import { english, type Locale } from '../../../i18n';

interface Props {
  variant?: 'original' | 'split' | 'wide' | 'inset' | 'editorial' | 'panorama' | 'mapfirst' | 'integrated' | 'location' | 'atlas' | 'paper' | 'ink' | 'district';
  copyVariant?: 'baseline' | 'editorial';
  locale?: Locale;
}

const { variant = 'original', copyVariant = 'baseline', locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.area : area;
const isNewVariant = ['panorama', 'mapfirst', 'integrated', 'location', 'atlas', 'paper', 'ink', 'district'].includes(variant);
const hasStyledMap = ['atlas', 'paper', 'ink', 'district'].includes(variant);
const showAreaDetails = copyVariant !== 'editorial';
const ctaVariant = copyVariant === 'editorial' ? 'primary' : 'ghost';
const mapZoom = variant === 'district' ? area.location.districtZoom : area.location.zoom;
const mapTitle = getMapTitle(area.location, variant === 'district');
const mapSrc = getOpenStreetMapEmbedUrl(area.location, mapZoom);
const mapUrl = getOpenStreetMapUrl(area.location, mapZoom);
---

<div id={`obszar-${variant}-${copyVariant}`} class="area-anchor" data-area={variant}>
  <Section class="area-section home-section-spacing">
    <Container>
      <div class:list={['area-panel', `area-panel--${variant}`]}>
        <div class:list={['area-copy', `area-copy--${copyVariant}`]}>
          <Heading level={2} variant="section-heading-xl" class="area-title text-[clamp(2rem,6vw,2.5rem)] leading-[1.02] tracking-[-0.045em] md:text-[clamp(2.5rem,3.5vw,3.25rem)] md:leading-[1]">{copy.title}</Heading>
          <Text class="area-description">{copy.description}</Text>
          {isNewVariant && showAreaDetails && (
            <div class="area-location">
              <Text class="area-location-label">{locale === 'en' ? english.area.locationLabel : 'Przykładowa lokalizacja'}</Text>
              <Text class="area-location-address">{area.location.label}</Text>
              <a href={mapUrl} target="_blank" rel="noreferrer">{locale === 'en' ? english.area.openMap : 'Otwórz mapę OpenStreetMap'}</a>
            </div>
          )}
          {showAreaDetails && (
            <ul class="area-scopes" aria-label={locale === 'en' ? english.area.scopesLabel : 'Rodzaje obsługiwanych inwestycji'}>
              {(locale === 'en' ? english.area.scopes : area.scopes).map((scope) => <li>{scope}</li>)}
            </ul>
          )}
          <Button href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'} variant={ctaVariant} class="area-cta">
            {copy.cta}
            <span slot="icon-right" class="arrow-loop--inline arrow-loop--r" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span></span>
          </Button>
        </div>

        {hasStyledMap ? (
          <LocationMap variant={variant as 'atlas' | 'paper' | 'ink' | 'district'} location={area.location} label={locale === 'en' ? english.area.mapTitle : undefined} />
        ) : (
          <figure class="area-map">
            <iframe class="area-map-frame" src={mapSrc} title={locale === 'en' ? english.area.mapTitle : mapTitle} loading="lazy"></iframe>
            <figcaption>
              <span>{locale === 'en' ? `${english.area.locationLabel}: ${area.location.label}` : `Przykładowa lokalizacja: ${area.location.label}`}</span>
              <a href={mapUrl} target="_blank" rel="noreferrer">{locale === 'en' ? english.area.openMap : 'Otwórz mapę OpenStreetMap'}</a>
              <span class="area-attribution">© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> {locale === 'en' ? english.area.attribution : 'contributors'}</span>
            </figcaption>
          </figure>
        )}
      </div>
    </Container>
  </Section>
</div>
