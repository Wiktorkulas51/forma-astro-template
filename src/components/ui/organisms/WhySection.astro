---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import why from '../../../data/sections/why-section.json';
import { getResponsiveImageSrcSet } from '@utils/responsive-image';
import { english, type Locale } from '../../../i18n';
interface Props { variant?: 'original' | 'shape' | 'stack' | 'collage'; locale?: Locale; }
const { variant = 'collage', locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.why : why;
const gallery = locale === 'en' ? english.why.gallery.map((photo, index) => ({ ...why.gallery[index], ...photo })) : why.gallery;
---

<Section class="why-section home-section-spacing">
  <Container>
    <div class="why-layout">
      {variant === 'original' ? (
      <figure class="why-figure">
        <img
          src={why.image}
          srcset={getResponsiveImageSrcSet(why.image, 1600)}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt={why.imageAlt}
          width="1450"
          height="967"
          loading="lazy"
          decoding="async"
        />
      </figure>
      ) : variant === 'shape' ? (
        <figure class="why-art why-art--shape">
          <div class="why-shape-photo">
          <img src={gallery[1].image} srcset={getResponsiveImageSrcSet(gallery[1].image, 1086)} sizes="(max-width: 900px) 100vw, 50vw" alt={gallery[1].alt} width="1086" height="1448" loading="lazy" decoding="async" />
          </div>
          <div class="why-shape-detail">
            <img src={gallery[2].image} srcset={getResponsiveImageSrcSet(gallery[2].image, 1086)} sizes="(max-width: 900px) 100vw, 50vw" alt={gallery[2].alt} width="1086" height="1448" loading="lazy" decoding="async" />
          </div>
        </figure>
      ) : (
        <figure class:list={['why-art', `why-art--${variant}`]}>
          <div class="why-art-photos">
            {gallery.map((photo, index) => (
              <div class:list={['why-art-photo', `why-art-photo--${index + 1}`]}>
                <img src={photo.image} srcset={getResponsiveImageSrcSet(photo.image, 1086)} sizes="(max-width: 900px) 100vw, 50vw" alt={photo.alt} width="1086" height="1448" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </figure>
      )}

      <div class="why-content">
        <Heading level={2} variant="section-heading-xl" class="why-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">
          {copy.title}
        </Heading>
        <div class="why-grid">
          {copy.items.map((item, index) => (
            <article class="why-item">
              <Text class="why-number" aria-hidden="true">0{index + 1}</Text>
              <Heading level={3} variant="feature-title" class="why-item-title text-[clamp(1.625rem,2.1vw,2.25rem)] leading-[1.02] tracking-[-0.035em]">
                {item.title}
              </Heading>
              <Text variant="feature-body-sm" class="why-description">
                {item.description}
              </Text>
            </article>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
