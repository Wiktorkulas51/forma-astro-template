---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import services from '@data/sections/services.json';
import { english, type Locale } from '../../../i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.services : services;
const actionLabels = locale === 'en' ? english.services.items.map((item) => item.action) : ['Omów budowę', 'Omów remont', 'Omów wykończenie'];
---

<Section id="uslugi" class="services-section home-section-spacing">
  <Container>
    <div class="services-heading">
      <Heading level={2} variant="section-heading-xl" class="services-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">
        {copy.title}
      </Heading>
    </div>

    <div class="services-grid">
      {copy.items.map((item, index) => (
        <article class:list={['service-card', `service-card--${index + 1}`]}>
          <Text class="service-number" aria-hidden="true">0{index + 1}</Text>

          {index === 0 && (
            <img
              class="service-image service-image--exterior"
              src="/assets/placeholders/image-portrait.svg"
              sizes="(max-width: 900px) 100vw, 33vw"
              alt=""
              width="1000"
              height="1400"
              loading="lazy"
              decoding="async"
            />
          )}

          {index === 1 && (
            <img
              class="service-image service-image--house"
              src="/assets/placeholders/image-landscape.svg"
              sizes="(max-width: 900px) 100vw, 33vw"
              alt=""
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          )}

          {index === 2 && (
            <img
              class="service-image service-image--interior"
              src="/assets/placeholders/image-landscape.svg"
              sizes="(max-width: 900px) 100vw, 33vw"
              alt=""
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          )}

          <div class="service-copy">
            <Heading level={3} variant="feature-title" class="service-title text-[clamp(1.625rem,2.1vw,2.25rem)] leading-[1.02] tracking-[-0.035em]">{item.title}</Heading>
            <Text variant="feature-body-sm" class="service-description text-base leading-[1.6]">{item.description}</Text>
            <a class="service-text-link" href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'}>{actionLabels[index]}</a>
          </div>

          <Button
            href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'}
            size="icon"
            variant="primary"
            class="service-action"
            aria-label={locale === 'en' ? `${actionLabels[index]} using the enquiry form` : `${actionLabels[index]} przez formularz kontaktowy`}
          >
            <span class="arrow-loop--inline" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15 15 5m0 0H7m8-0v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15 15 5m0 0H7m8-0v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span></span>
          </Button>
        </article>
      ))}
    </div>
  </Container>
</Section>
