---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import projects from '../../../data/sections/projects-section.json';
import ProjectGallery from './ProjectGallery';
import { getResponsiveImageSrcSet } from '@utils/responsive-image';
import { english, type Locale } from '../../../i18n';
interface Props { variant?: 'original' | 'morph' | 'editorial' | 'morph-refined'; locale?: Locale; }
const { variant = 'morph-refined', locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.projects : projects;
const localizedProjects = copy.items.map((item, index) => ({ ...projects.items[index], ...item }));
---

<Section class="projects-section home-section-spacing">
  <Container>
    {variant === 'original' ? (
    <div class="projects-panel">
      <header class="projects-heading">
        <div>
          <Heading level={2} variant="section-heading-xl" class="projects-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">
            {copy.title}
          </Heading>
        </div>
        <Text class="projects-intro">{copy.description}</Text>
      </header>

      <div class="projects-grid">
        {localizedProjects.map((project, index) => (
          <article class:list={['project-card', `project-card--${index + 1}`]}>
            <img
              src={project.image}
              srcset={getResponsiveImageSrcSet(project.image, 1600)}
              sizes="(max-width: 900px) 100vw, 33vw"
              alt={project.alt}
              width="1450"
              height="967"
              loading="lazy"
              decoding="async"
            />
            <div class="project-shade"></div>
            <Text class="project-category">{project.category}</Text>
            <Heading level={3} variant="feature-title" class="project-name text-[clamp(1.625rem,2.1vw,2.25rem)] leading-[1.02] tracking-[-0.035em]">
              {project.title}
            </Heading>
          </article>
        ))}
      </div>
    </div>
    ) : variant === 'morph' || variant === 'morph-refined' ? (
      <ProjectGallery projects={{ ...projects, ...copy, items: localizedProjects }} selectionLabel={locale === 'en' ? 'Choose a project' : undefined} locale={locale} refined={variant === 'morph-refined'} client:visible />
    ) : (
      <>
        <header class="projects-heading projects-heading--editorial">
          <Heading level={2} variant="section-heading-xl" class="projects-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">{copy.title}</Heading>
          <Text class="projects-editorial-intro">{copy.description}</Text>
        </header>
        <ProjectGallery projects={{ ...projects, ...copy, items: localizedProjects }} selectionLabel={locale === 'en' ? 'Choose a project' : undefined} locale={locale} mode="editorial" client:visible />
      </>
    )}

    <Button href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'} variant="ghost" class="projects-cta">
      {locale === 'en' ? english.projects.cta : projects.cta}
      <span slot="icon-right" class="arrow-loop--inline arrow-loop--r" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg></span></span>
    </Button>
  </Container>
</Section>
