---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import testimonials from '../../../data/sections/testimonials-section.json';
import TestimonialSlider from './TestimonialSlider';
import { english, type Locale } from '../../../i18n';
interface Props { refinement?: 'air' | 'frame' | 'warm' | 'detail'; variant?: 'original' | 'balanced' | 'slide' | 'project' | 'editorial' | 'spread' | 'centered' | 'framed' | 'quiet'; locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.testimonials : testimonials;
const sliderItems = locale === 'en' ? english.testimonials.items.map((item, index) => ({ ...testimonials.items[index], ...item })) : testimonials.items;
const hasExplicitVariant = Astro.props.variant !== undefined;
const variant = Astro.props.variant ?? 'spread';
const refinement = Astro.props.refinement ?? (hasExplicitVariant ? undefined : 'warm');
---

<Section class="testimonials-section home-section-spacing">
  <Container>
    <div class:list={['testimonials-layout', variant !== 'original' && `testimonials-layout--${variant}`, refinement && `testimonials-refinement--${refinement}`]}>
      <header class="testimonials-heading">
        <Heading level={2} variant="section-heading-xl" class="testimonials-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">
          {variant === 'original' ? copy.title : locale === 'en' ? english.testimonials.introTitle : 'Dobra współpraca zostaje w pamięci.'}
        </Heading>
        <Text class="testimonials-intro">{variant === 'original' ? copy.description : locale === 'en' ? english.testimonials.intro : 'Najwięcej mówią doświadczenia z konkretnych prac. Tak może wyglądać miejsce na opinie Państwa klientów.'}</Text>
      </header>

      {variant === 'original' ? (
      <figure class="testimonial-quote">
        <span class="testimonial-mark" aria-hidden="true">“</span>
        <blockquote>
          <Text class="testimonial-copy">{copy.quote}</Text>
        </blockquote>
        <figcaption>{copy.caption}</figcaption>
      </figure>
      ) : <TestimonialSlider items={sliderItems} mode={variant} labels={locale === 'en' ? english.testimonials : undefined} client:visible />}
    </div>
  </Container>
</Section>
