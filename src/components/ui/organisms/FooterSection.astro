---
import Container from '@components/ui/layout/Container.astro';
import company from '@data/global/company.json';
import '../../../styles/footer.css';
import { english, type Locale } from '../../../i18n';

interface Props {
  variant?: 'original' | 'lines' | 'airy' | 'compact' | 'warm' | 'graphite-air' | 'graphite-grid' | 'graphite-signature' | 'graphite-quiet';
  locale?: Locale;
}

const { variant = 'original', locale = 'en' } = Astro.props;
const links = [
  { label: locale === 'en' ? 'Services' : 'Usługi', href: locale === 'en' ? '/#uslugi' : '/pl/#uslugi' },
  { label: locale === 'en' ? 'Projects' : 'Realizacje', href: locale === 'en' ? '/#realizacje' : '/pl/#realizacje' },
  { label: locale === 'en' ? 'Contact' : 'Kontakt', href: locale === 'en' ? '/#kontakt' : '/pl/#kontakt' },
  ...(variant !== 'original' ? [{ label: locale === 'en' ? 'Working together' : 'Współpraca', href: locale === 'en' ? '/#dlaczego-my' : '/pl/#dlaczego-my' }, { label: locale === 'en' ? 'Questions and answers' : 'Pytania i odpowiedzi', href: locale === 'en' ? '/#faq' : '/pl/#faq' }] : []),
];
---

<footer class:list={['footer', `footer--${variant}`]}>
  <Container>
    {variant !== 'original' && <div class="footer-intro"><p>{locale === 'en' ? english.footer.intro : <>Od pomysłu do miejsca,<br />w którym dobrze się żyje.</>}</p><a href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'}>{locale === 'en' ? english.footer.cta : 'Porozmawiajmy o projekcie'} <span class="arrow-loop--inline" aria-hidden="true"><span class="arrow-loop-out">↗</span><span class="arrow-loop-in">↗</span></span></a></div>}
    <div class="footer-inner">
      <a class="footer-wordmark" href={locale === 'en' ? '/#top' : '/pl/#top'} aria-label={locale === 'en' ? english.nav.home : 'FORMA, początek strony'}>
        <img src={company.branding.logoImage} alt="FORMA" width="768" height="146" loading="lazy" decoding="async" />
      </a>
      <nav aria-label={locale === 'en' ? english.footer.aria : 'Stopka'}>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="footer-note footer-credit" href="https://github.com/Wiktorkulas51/forma-astro-template" target="_blank" rel="noopener noreferrer">{locale === 'en' ? english.footer.credit : 'Szablon FORMA'}</a>
    </div>
  </Container>
</footer>
