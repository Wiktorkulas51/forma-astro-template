---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import hero from '@data/sections/hero.json';
import { english, type Locale } from '../../../i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.hero : hero;

const titleWithoutFinalPeriod = copy.title.replace(/\.$/, '');
const hasFinalPeriod = copy.title.endsWith('.');
---

<Section class="hero-section py-0">
  <Container>
    <div class="hero-grid">
      <figure class="hero-photo">
        <img
          src="/assets/placeholders/image-landscape.svg"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt=""
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="hero-copy px-[clamp(1.5rem,6vw,5.5rem)] py-6">
        <div class="hero-message">
          <Heading level={1} variant="hero" class="hero-title font-semibold text-[clamp(2.75rem,10vw,3.375rem)] leading-[0.94] tracking-[-0.045em] md:text-[clamp(3.625rem,6vw,4.5rem)] xl:text-[clamp(4.25rem,5.5vw,5.5rem)] xl:leading-[0.92] xl:tracking-[-0.055em]">
            {titleWithoutFinalPeriod}{hasFinalPeriod && <span class="text-brand-primary">.</span>}
          </Heading>
          <Text variant="lead" class="hero-description text-xl leading-[1.45] tracking-[-0.015em]">{copy.description}</Text>
          <Button href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'} variant="primary" size="lg" class="hero-button">
            {locale === 'en' ? english.hero.cta : hero.primaryCta.label}
            <span slot="icon-right" class="arrow-loop--inline arrow-loop--r" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span></span>
          </Button>
        </div>

        <div class="service-rail" aria-label={locale === 'en' ? 'Demonstration services' : 'Zakres usług demonstracyjnych'}>
          {(locale === 'en' ? english.hero.services : ['Budowa domów', 'Remonty', 'Wykończenia']).map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </Container>
</Section>
