---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import process from '../../../data/sections/process-section.json';
import { english, type Locale } from '../../../i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.process : process;
---

<Section id="proces" class="process-section home-section-spacing">
  <Container>
    <header class="process-heading">
      <div>
        <Heading level={2} variant="section-heading-xl" class="process-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">
          {copy.title}
        </Heading>
      </div>
      <Text class="process-intro">{copy.description}</Text>
    </header>

    <ol class="process-steps">
      {copy.steps.map((step, index) => (
        <li class="process-step">
          <Text class="process-number" aria-hidden="true">0{index + 1}</Text>
          <Heading level={3} variant="feature-title" class="process-step-title text-[clamp(1.625rem,2.1vw,2.25rem)] leading-[1.02] tracking-[-0.035em]">
            {step.title}
          </Heading>
          <Text variant="feature-body-sm" class="process-step-description">
            {step.description}
          </Text>
        </li>
      ))}
    </ol>

    <Button href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'} variant="ghost" class="process-cta">
      {copy.cta}
      <span slot="icon-right" class="arrow-loop--inline arrow-loop--r" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg></span></span>
    </Button>
  </Container>
</Section>
