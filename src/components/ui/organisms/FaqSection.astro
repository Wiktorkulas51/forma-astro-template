---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import faq from '../../../data/sections/faq-section.json';
import { english, type Locale } from '../../../i18n';

interface Props {
  variant?: 'original' | 'split' | 'wide' | 'inset' | 'editorial' | 'cards' | 'stack' | 'index' | 'focus';
  locale?: Locale;
}

const { variant = 'original', locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.faq : faq;
---

<div id={`faq-${variant}`} class="faq-anchor" data-faq={variant}>
  <Section class="faq-section home-section-spacing">
    <Container>
      <div class:list={['faq-layout', `faq-layout--${variant}`]}>
        <header class="faq-heading">
          <Heading level={2} variant="section-heading-xl" class:list={['faq-title', variant === 'original' ? 'text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]' : 'text-[clamp(2rem,6vw,2.5rem)] leading-[1.02] tracking-[-0.045em] md:text-[clamp(2.5rem,3.5vw,3.25rem)] md:leading-[1]']}>{copy.title}</Heading>
          <Text class="faq-intro">{copy.description}</Text>
          <div class="faq-side faq-side--contact">
            <p class="faq-side-title">{locale === 'en' ? english.faq.contactTitle : 'Masz konkretny temat?'}</p>
            <p>{locale === 'en' ? english.faq.contactText : 'Opowiedz nam o planowanych pracach, a porozmawiamy o możliwym zakresie.'}</p>
            <a class="faq-contact-link" href="#kontakt">{locale === 'en' ? english.faq.contactLink : 'Przejdź do formularza'} <span class="arrow-loop--inline" aria-hidden="true"><span class="arrow-loop-out">↗</span><span class="arrow-loop-in">↗</span></span></a>
          </div>
        </header>
        {variant === 'index' ? (
          <div class="faq-tabs" data-faq-tabs>
            <div role="tablist" aria-label={locale === 'en' ? english.faq.tabLabel : 'Pytania o współpracę'} class="faq-tablist">
              {copy.items.map((item, i) => <button type="button" role="tab" id={`faq-${variant}-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`faq-${variant}-panel-${i}`} tabindex={i === 0 ? 0 : -1}>{item.question}</button>)}
            </div>
            <div class="faq-panels">
              {copy.items.map((item, i) => <div role="tabpanel" id={`faq-${variant}-panel-${i}`} aria-labelledby={`faq-${variant}-tab-${i}`} hidden={i !== 0} tabindex="0"><Heading level={3}>{item.question}</Heading><Text>{item.answer}</Text></div>)}
            </div>
          </div>
        ) : variant === 'stack' ? (
          <div class="faq-static">
            {copy.items.map((item, i) => <article><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><Heading level={3}>{item.question}</Heading><Text>{item.answer}</Text></article>)}
          </div>
        ) : (
        <div class:list={['faq-list', `faq-list--${variant}`]} data-faq-accordion={variant}>
          {copy.items.map((item, index) => (
            <details class:list={['faq-item', variant === 'focus' && index === 0 && 'faq-item--featured']} open={index === 0} name={`faq-${variant}`}>
              <summary>
                {['editorial', 'stack', 'index', 'focus'].includes(variant) && <span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
                <span class="faq-question">{item.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <Text class="faq-answer">{item.answer}</Text>
            </details>
          ))}
        </div>
        )}
      </div>
    </Container>
  </Section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const activate = (index: number) => {
      // Widoczna odpowiedź pozostaje powiązana z aktywnym pytaniem także dla klawiatury.
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; panels[i].hidden = i !== index; });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (i + (['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1) + tabs.length) % tabs.length;
        activate(next); tabs[next].focus();
      });
    });
  });

  // Każda instancja utrzymuje akordeon we własnej liście, niezależnie od innych wariantów.
  document.querySelectorAll<HTMLElement>('[data-faq-accordion]').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('details'));
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item && other.open) other.open = false;
        });
      });
    });
  });
</script>
