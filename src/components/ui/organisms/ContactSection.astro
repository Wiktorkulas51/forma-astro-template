---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Button from '@components/ui/atoms/Button.astro';
import Input from '@components/ui/atoms/Input.astro';
import Textarea from '@components/ui/atoms/Textarea.astro';
import Container from '@components/ui/layout/Container.astro';
import Section from '@components/ui/layout/Section.astro';
import contact from '../../../data/sections/contact-section.json';
import company from '@data/global/company.json';
import { getResponsiveImageSrcSet } from '@utils/responsive-image';
import { english, type Locale } from '../../../i18n';

interface Props {
  variant?: 'original' | 'lines' | 'airy' | 'compact' | 'warm' | 'compact-air' | 'compact-grid' | 'compact-flow' | 'compact-soft';
  showFooter?: boolean;
  instance?: string;
  locale?: Locale;
}

const { variant = 'original', showFooter = true, instance, locale = 'en' } = Astro.props;
const copy = locale === 'en' ? english.contact : contact;
const fieldId = (name: string) => `${instance ?? variant}-${name}`;
const plWorkTypes = [
  { value: 'budowa', label: 'Budowa' },
  { value: 'remont', label: 'Remont' },
  { value: 'wykonczenie', label: 'Wykończenie' },
];
const workTypes = plWorkTypes.map((item, index) => ({ ...item, label: locale === 'en' ? english.contact.workTypes[index] : item.label }));
---

<Section id={`kontakt-${instance ?? variant}`} class:list={["contact-section", `contact--${variant}`, variant.startsWith('compact-') && 'contact--compact', "home-section-spacing"]}>
  <Container motionMedia>
    <div class="contact-grid">
      <div class="contact-story">
        <img src={contact.image} srcset={getResponsiveImageSrcSet(contact.image, 1600)} sizes="(max-width: 900px) 100vw, 50vw" alt={locale === 'en' ? english.contact.imageAlt : contact.imageAlt} width="1600" height="1067" loading="lazy" decoding="async" />
        <div class="contact-story-copy">
          <Heading level={2} variant="section-heading-xl" class="contact-story-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">{copy.imageTitle}</Heading>
          <Text>{locale === 'en' ? english.contact.imageCopy : contact.imageCopy}</Text>
        </div>
      </div>

      <div class="contact-form-panel">
        <Heading level={2} variant="section-heading-lg" class="contact-form-title text-[clamp(2.25rem,8vw,2.75rem)] leading-[0.98] tracking-[-0.05em] md:text-[clamp(3rem,4vw,4rem)] md:leading-[0.96]">{copy.formTitle}</Heading>
        <form class="contact-form" data-contact-form data-success={copy.success}>
          <div class="contact-fields">
            <div class="contact-field">
              <label class="sr-only" for={fieldId('name')}>{locale === 'en' ? english.contact.name : 'Imię'}</label>
              <Input id={fieldId('name')} name="name" autocomplete="name" placeholder={locale === 'en' ? english.contact.name : 'Imię'} required />
            </div>
            <div class="contact-field">
              <label class="sr-only" for={fieldId('email')}>{locale === 'en' ? english.contact.email : 'E-mail'}</label>
              <Input id={fieldId('email')} name="email" type="email" autocomplete="email" placeholder={locale === 'en' ? english.contact.email : 'E-mail'} required />
            </div>
            <div class="contact-field">
              <label class="sr-only" for={fieldId('phone')}>{locale === 'en' ? english.contact.phone : 'Telefon (opcjonalnie)'}</label>
              <Input id={fieldId('phone')} name="phone" type="tel" autocomplete="tel" placeholder={locale === 'en' ? english.contact.phone : 'Telefon (opcjonalnie)'} />
            </div>
            <div class="contact-field">
              <label class="sr-only" id={fieldId('work-type-label')} for={fieldId('work-type-trigger')}>{locale === 'en' ? english.contact.workType : 'Rodzaj prac'}</label>
              <div class="contact-select" data-contact-select>
                <select class="contact-select-native" id={fieldId('work-type')} name="workType" tabindex="-1" aria-hidden="true">
                  <option value="" selected>{locale === 'en' ? english.contact.workType : 'Rodzaj prac'}</option>
                  {workTypes.map((workType) => <option value={workType.value}>{workType.label}</option>)}
                </select>
                <button
                  class="contact-select-trigger"
                  id={fieldId('work-type-trigger')}
                  type="button"
                  aria-labelledby={fieldId('work-type-label')}
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls={fieldId('work-type-options')}
                  aria-describedby={fieldId('work-type-error')}
                  aria-required="true"
                  data-select-trigger
                  data-has-value="false"
                >
                  <span data-select-value>{locale === 'en' ? english.contact.workType : 'Rodzaj prac'}</span>
                </button>
                <div class="contact-select-menu" id={fieldId('work-type-options')} role="listbox" aria-labelledby={fieldId('work-type-label')} hidden>
                  {workTypes.map((workType, index) => (
                    <div
                      class="contact-select-option"
                      id={fieldId(`work-type-option-${index}`)}
                      role="option"
                      aria-selected="false"
                      data-select-option
                      data-value={workType.value}
                    >{workType.label}</div>
                  ))}
                </div>
              </div>
              <span class="contact-select-error" id={fieldId('work-type-error')} role="alert" hidden>{locale === 'en' ? english.contact.workTypeError : 'Wybierz rodzaj prac.'}</span>
            </div>
            <div class="contact-field contact-field--wide">
              <label class="sr-only" for={fieldId('message')}>{locale === 'en' ? english.contact.message : 'Kilka słów o projekcie'}</label>
              <Textarea id={fieldId('message')} name="message" rows={4} placeholder={locale === 'en' ? english.contact.message : 'Kilka słów o projekcie'} required />
            </div>
          </div>
          <Text class="contact-privacy-note">{locale === 'en' ? english.contact.privacy : 'Wysyłając zapytanie, potwierdzają Państwo zapoznanie się z'} <a href={locale === 'en' ? '/privacy-policy/' : '/pl/privacy-policy/'}>{locale === 'en' ? english.contact.privacyLink : 'polityką prywatności'}</a>.</Text>
          <Button type="submit" variant="primary" size="lg" class="contact-submit">
            {copy.submit}
            <span slot="icon-right" class="arrow-loop--inline arrow-loop--r" aria-hidden="true"><span class="arrow-loop-out"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span><span class="arrow-loop-in" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span></span>
          </Button>
          <Text class="contact-status" role="status" aria-live="polite"></Text>
        </form>
      </div>
    </div>

    {showFooter && <footer class="contact-footer">
      <a class="contact-wordmark" href={locale === 'en' ? '/#top' : '/pl/#top'} aria-label={locale === 'en' ? english.nav.home : 'FORMA, początek strony'}>
        <img src={company.branding.logoImage} alt="FORMA" width="768" height="146" loading="lazy" decoding="async" />
      </a>
      <a class="contact-credit" href="https://github.com/Wiktorkulas51/forma-astro-template" target="_blank" rel="noopener noreferrer">{locale === 'en' ? english.contact.credit : 'Szablon FORMA'}</a>
      <nav aria-label={locale === 'en' ? english.contact.footer : 'Stopka'}>
        <a href={locale === 'en' ? '/#uslugi' : '/pl/#uslugi'}>{locale === 'en' ? english.contact.nav[0] : 'Usługi'}</a>
        <a href={locale === 'en' ? '/#realizacje' : '/pl/#realizacje'}>{locale === 'en' ? english.contact.nav[1] : 'Realizacje'}</a>
        <a href={locale === 'en' ? '/#kontakt' : '/pl/#kontakt'}>{locale === 'en' ? english.contact.nav[2] : 'Kontakt'}</a>
      </nav>
    </footer>}
  </Container>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact-select]').forEach((control) => {
    const select = control.querySelector<HTMLSelectElement>('.contact-select-native');
    const trigger = control.querySelector<HTMLButtonElement>('[data-select-trigger]');
    const menu = control.querySelector<HTMLElement>('[role="listbox"]');
    const valueLabel = control.querySelector<HTMLElement>('[data-select-value]');
    const error = control.parentElement?.querySelector<HTMLElement>('.contact-select-error');
    const options = Array.from(control.querySelectorAll<HTMLElement>('[data-select-option]'));
    if (!select || !trigger || !menu || !valueLabel) return;

    let activeIndex = -1;
    const closeMenu = () => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    };
    const setActiveOption = (index: number) => {
      activeIndex = (index + options.length) % options.length;
      trigger.setAttribute('aria-activedescendant', options[activeIndex].id);
      options.forEach((option, optionIndex) => option.classList.toggle('is-active', optionIndex === activeIndex));
    };
    const openMenu = () => {
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      const selectedIndex = options.findIndex((option) => option.dataset.value === select.value);
      setActiveOption(selectedIndex >= 0 ? selectedIndex : 0);
    };
    const selectOption = (option: HTMLElement) => {
      select.value = option.dataset.value ?? '';
      valueLabel.textContent = option.textContent?.trim() ?? '';
      trigger.dataset.hasValue = String(Boolean(select.value));
      trigger.setAttribute('aria-invalid', 'false');
      options.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
      if (error) error.hidden = true;
      select.dispatchEvent(new Event('change', { bubbles: true }));
      closeMenu();
    };

    trigger.addEventListener('click', () => menu.hidden ? openMenu() : closeMenu());
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (menu.hidden) openMenu();
        else setActiveOption(activeIndex + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        if (menu.hidden) openMenu();
        setActiveOption(event.key === 'Home' ? 0 : options.length - 1);
      } else if ((event.key === 'Enter' || event.key === ' ') && !menu.hidden) {
        event.preventDefault();
        if (options[activeIndex]) selectOption(options[activeIndex]);
      } else if (event.key === 'Escape' || event.key === 'Tab') {
        closeMenu();
      }
    });
    options.forEach((option, index) => {
      option.addEventListener('pointerenter', () => setActiveOption(index));
      option.addEventListener('click', () => selectOption(option));
    });
    document.addEventListener('pointerdown', (event) => {
      if (!control.contains(event.target as Node)) closeMenu();
    });
  });

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const select = form.querySelector<HTMLSelectElement>('.contact-select-native');
      const trigger = form.querySelector<HTMLButtonElement>('[data-select-trigger]');
      const selectError = form.querySelector<HTMLElement>('.contact-select-error');
      if (select && !select.value && trigger) {
        trigger.setAttribute('aria-invalid', 'true');
        if (selectError) selectError.hidden = false;
        trigger.focus();
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const status = form.querySelector<HTMLElement>('.contact-status');
      if (status) status.textContent = form.dataset.success ?? '';
    });
  });
</script>
