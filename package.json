{
  "name": "forma-astro-template",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4345 --strictPort",
    "build": "node src/scripts/clean-dist.mjs --before-build && npm run assets:fonts && npm run assets:img && npm run assets:responsive && node src/scripts/scope-pages.mjs build && node src/scripts/clean-dist.mjs && npm run assets:prune",
    "preview": "astro preview",
    "astro": "astro",
    "scope:restore": "node src/scripts/scope-pages.mjs restore",
    "check:public": "node scripts/check-public-ready.mjs",
    "ai:check": "npm run check:public && npm run check && npm run test -- --run",
    "assets:img": "tsx src/scripts/optimize-images.ts",
    "assets:responsive": "node scripts/generate-responsive-images.mjs",
    "assets:thumbs": "tsx src/scripts/generate-gallery-thumbs.ts",
    "assets:fonts": "tsx src/scripts/download-fonts.ts",
    "assets:videos": "node src/scripts/compress-videos.mjs",
    "assets:prune": "node src/scripts/prune-images.mjs",
    "dist:clean": "node src/scripts/clean-dist.mjs",
    "design:sync": "tsx src/scripts/sync-design.ts",
    "check": "astro check",
    "check:links": "vitest run src/quality/links.test.ts",
    "check:seo": "vitest run src/quality/seo.test.ts",
    "check:images": "vitest run src/quality/images.test.ts",
    "check:build-output": "vitest run src/quality/build-output.test.ts src/quality/content-sections.test.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "motion": "^13.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "description": "Free bilingual Astro template for construction and renovation businesses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiktorkulas51/forma-astro-template.git"
  },
  "homepage": "https://github.com/Wiktorkulas51/forma-astro-template#readme",
  "bugs": {
    "url": "https://github.com/Wiktorkulas51/forma-astro-template/issues"
  }
}
